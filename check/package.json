{
  "name": "recognizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "recognizer": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "mkdir -p src/generated && cp ../schema/scan.schema.json src/generated/scan.schema.json && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
