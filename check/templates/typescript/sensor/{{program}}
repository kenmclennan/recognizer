#!/bin/sh
self=$0

while [ -h "$self" ]; do
  directory=$(cd "$(dirname "$self")" && pwd)
  target=$(readlink "$self")

  case $target in
    /*) self=$target ;;
    *) self=$directory/$target ;;
  esac
done

folder=$(cd "$(dirname "$self")" && pwd)

exec node --experimental-strip-types --disable-warning=ExperimentalWarning "$folder/src/main.ts" "$@"
