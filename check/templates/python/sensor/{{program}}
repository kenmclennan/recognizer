#!/usr/bin/env python3
# {{program}}: a Recognizer sensor written in Python (standard library only).
# Run `recognizer help plugin-guide` for the contract this program follows.
import json
import os
import signal
import subprocess
import sys

PROGRAM = "{{program}}"
VERSION = "0.1.0"

# EDIT HERE: declare each metric and finding kind this sensor produces.
MANIFEST = {
    "kind": "sensor",
    "name": "{{name}}",
    "display": "{{name}}",
    "version": VERSION,
    "protocol": {{protocol}},
    "install": "put {{program}} on PATH (EDIT HERE: say how your users install it)",
    "check": True,
    "long_running": True,
    "units": ["modules"],
    "settings": [],
    "metrics": [],
    "findings": [],
    "runs_tests": False,
    "scoped": False,
}

STOP_EXIT = 143

state = {"commit": None, "modified": False, "output": None, "measured": 0, "total": 1}


def event(payload):
    sys.stderr.write("recognizer-event " + json.dumps(payload) + "\n")
    sys.stderr.flush()


def write_findings(stopped):
    document = {
        "findings_version": {{findings_version}},
        "sensor": {"name": "{{name}}", "version": VERSION},
        "commit": state["commit"],
        "modified": state["modified"],
        "inputs": {},
        "settings": {},
        "findings": [],
    }

    if stopped:
        document["stopped"] = {"measured": state["measured"], "total": state["total"]}

    output = state["output"]
    temporary = "%s.%d.tmp" % (output, os.getpid())

    with open(temporary, "w") as handle:
        json.dump(document, handle, indent=2)
        handle.write("\n")

    os.replace(temporary, output)


def on_term(signum, frame):
    if state["output"] is not None:
        write_findings(True)

    sys.exit(STOP_EXIT)


def run(arguments):
    repository = None
    commit = None
    output = None
    index = 0

    while index < len(arguments):
        argument = arguments[index]
        has_value = index + 1 < len(arguments)

        if argument == "--repository" and has_value:
            repository = arguments[index + 1]
        elif argument == "--commit" and has_value:
            commit = arguments[index + 1]
        elif argument == "--output" and has_value:
            output = arguments[index + 1]
        elif argument == "--settings" and has_value:
            pass
        else:
            return usage()

        index += 2

    if repository is None or commit is None or output is None:
        return usage()

    status = subprocess.run(
        ["git", "-C", repository, "status", "--porcelain"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    state["commit"] = commit
    state["modified"] = status.stdout.strip() != b""
    state["output"] = output
    signal.signal(signal.SIGTERM, on_term)

    event({"event": "start", "total": state["total"], "unit": "modules"})

    # EDIT HERE: measure the repository and append to the findings list.
    state["measured"] = 1

    event({"event": "progress", "done": 1, "total": state["total"], "unit": "modules"})
    write_findings(False)

    return 0


def usage():
    sys.stderr.write(
        "usage: " + PROGRAM + " manifest | check [--repository <dir>] | guide | "
        "run --repository <dir> --commit <sha> --output <file> [--settings <json>]\n"
    )

    return 2


def main(arguments):
    verb = arguments[0] if arguments else None

    if verb == "manifest":
        sys.stdout.write(json.dumps(MANIFEST, indent=2) + "\n")

        return 0

    if verb == "check":
        sys.stdout.write('{"gaps":[],"notes":[]}\n')

        return 0

    if verb == "guide":
        sys.stdout.write(
            PROGRAM + " measures nothing yet and writes no findings.\n"
            "It needs git on PATH and nothing else.\n"
            "Edit the EDIT HERE lines in this file to measure something.\n"
        )

        return 0

    if verb == "run":
        return run(arguments[1:])

    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
