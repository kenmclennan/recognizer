{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recognizer",
  "version": "0.1.0",
  "identifier": "com.kenmclennan.recognizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": { "signingIdentity": "-" },
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kenmclennan/recognizer-releases/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NEY5RTNGQjFCMEQwQjEKUldTeDBMQ3hQNTVQT1VMT1ZHNjM5ajA3NEVleXMrLytDWFh1TXRFNUZSSG5oTDVWVk1aZituNVcK"
    }
  }
}
