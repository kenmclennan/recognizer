{
  "name": "@recognizer/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w recognizer",
    "dev": "vite",
    "prebuild": "npm run build -w recognizer",
    "build": "vite build",
    "pretypecheck": "npm run build -w recognizer",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w recognizer",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings src/ scripts/ ../scripts/ vite.config.ts",
    "lint:fix": "biome check --write src/ scripts/ ../scripts/ vite.config.ts",
    "format:check": "biome format src/ scripts/ ../scripts/ vite.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "elkjs": "^0.12.0",
    "recognizer": "*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "typescript": "~5.9",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
