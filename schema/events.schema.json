{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/events.schema.json",
  "title": "Recognizer plugin event",
  "description": "One event a plugin writes on stderr while it runs, as a line `recognizer-event <json>`. This schema validates the JSON after the prefix; the prefix is not enforced by it.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "total",
        "unit"
      ],
      "properties": {
        "event": {
          "const": "start"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "not_measured": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reused", "no_covered_site", "out_of_scope"],
          "properties": {
            "reused": { "type": "integer", "minimum": 0 },
            "no_covered_site": { "type": "integer", "minimum": 0 },
            "out_of_scope": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "done",
        "total",
        "unit"
      ],
      "properties": {
        "event": {
          "const": "progress"
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "text"
      ],
      "properties": {
        "event": {
          "const": "note"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "code",
        "text"
      ],
      "properties": {
        "event": {
          "const": "diagnosis"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "name", "index", "of"],
      "properties": {
        "event": { "const": "stage" },
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 1 },
        "of": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "remaining_ms"],
      "properties": {
        "event": { "const": "estimate" },
        "remaining_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "const": "result"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "severity",
              "principle",
              "summary",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "violation",
                  "warning"
                ]
              },
              "principle": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "author",
                  "work",
                  "year"
                ],
                "properties": {
                  "author": {
                    "type": "string",
                    "minLength": 1
                  },
                  "work": {
                    "type": "string",
                    "minLength": 1
                  },
                  "year": {
                    "type": "integer"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "fix_pattern": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "modules"
                ],
                "properties": {
                  "modules": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "test_importers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "file",
                        "names"
                      ],
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "minLength": 1
                        },
                        "to": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "rules": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "module",
                        "name"
                      ],
                      "properties": {
                        "module": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "lines": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "test_files": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "measures": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "producer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "overlay": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "findings"
          ]
        },
        {
          "required": [
            "overlay"
          ]
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "modified",
        "settings"
      ],
      "properties": {
        "event": {
          "const": "settled"
        },
        "modified": {
          "type": "boolean"
        },
        "settings": {
          "type": "object"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "tests": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measured",
            "total"
          ],
          "properties": {
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stopped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measured",
            "total"
          ],
          "properties": {
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "partial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measured",
            "total"
          ],
          "properties": {
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functions",
            "modules"
          ],
          "properties": {
            "functions": {
              "type": "integer",
              "minimum": 0
            },
            "modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unowned": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functions",
            "modules"
          ],
          "properties": {
            "functions": {
              "type": "integer",
              "minimum": 0
            },
            "modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "ran_at"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "ok",
                  "failed",
                  "partial",
                  "never"
                ]
              },
              "ran_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "measured": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "ran": {
                "type": "boolean"
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "never"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "ran_at": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "ran_at": {
                  "type": "string"
                }
              }
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "performed",
            "reused"
          ],
          "properties": {
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "performed": {
              "type": "integer",
              "minimum": 0
            },
            "reused": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  ]
}
