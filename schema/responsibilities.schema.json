{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/responsibilities.schema.json",
  "title": "Recognizer module responsibilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": { "const": 1 },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "source_hash", "describer", "version"],
        "properties": {
          "line": { "type": "string", "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$" },
          "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "describer": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
