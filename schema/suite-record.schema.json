{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/suite-record.schema.json",
  "title": "Recognizer suite record",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_record_version", "sensor", "suites"],
  "properties": {
    "suite_record_version": { "const": 1 },
    "sensor": { "enum": ["crap", "mutation"] },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ran_at", "status", "inputs", "tests"],
        "properties": {
          "ran_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
          "status": { "enum": ["ok", "failed", "partial"] },
          "reason": { "type": "string", "minLength": 1 },
          "measured": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "inputs": { "$ref": "#/$defs/hashes" },
          "tests": { "$ref": "#/$defs/hashes" },
          "coverage": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
