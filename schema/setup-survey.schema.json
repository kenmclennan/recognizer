{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/setup-survey.schema.json",
  "title": "Recognizer setup survey",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "survey_version",
    "version",
    "repository",
    "configured",
    "files",
    "unread",
    "checks",
    "runners",
    "tools",
    "upgrade",
    "fixes",
    "suites",
    "policy"
  ],
  "properties": {
    "survey_version": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "configured": { "type": "boolean" },
    "files": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/languageMarked" }
    },
    "unread": {
      "type": "array",
      "items": { "$ref": "#/$defs/languageFiles" }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display",
          "description",
          "always_on",
          "enabled",
          "runs_tests",
          "limits",
          "mark"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "always_on": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "runs_tests": { "type": "boolean" },
          "mark": { "$ref": "#/$defs/mark" },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "default", "current"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "default": { "type": "number" },
                "current": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "runner",
          "directory",
          "from",
          "command",
          "coverage",
          "tool"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "runner": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["lcov", "jacoco"] }
            }
          },
          "tool": { "type": ["string", "null"] },
          "env": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "installed",
          "why",
          "needed_by",
          "installs",
          "command",
          "cwd"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["npm", "cargo", "pip"] },
          "installed": { "type": "boolean" },
          "why": { "type": "string" },
          "needed_by": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "installs": { "type": "string" },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 }
        }
      }
    },
    "upgrade": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject", "title", "line", "command"],
        "properties": {
          "code": {
            "enum": ["config-retired", "config-empty", "policy-retired"]
          },
          "subject": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "line": { "type": "string" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "subject",
          "title",
          "line",
          "fix_text",
          "command"
        ],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "subject": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "line": { "type": "string" },
          "fix_text": { "type": "string" },
          "command": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language", "directory", "command", "mark"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "language": { "type": "string" },
          "directory": { "type": "string" },
          "command": { "type": "string" },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "mark": { "enum": ["set-up", "gone"] }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "uncovered"],
      "properties": {
        "present": { "type": "boolean" },
        "uncovered": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "mark": { "enum": ["set-up", "new", "gone", null] },
    "languageMarked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "files", "folders", "mark"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "files": { "type": "integer", "minimum": 0 },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "files"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "files": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "mark": { "$ref": "#/$defs/mark" }
      }
    },
    "languageFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "files", "folders"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "files": { "type": "integer", "minimum": 0 },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "files"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "files": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
