{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kenmclennan/recognizer/schema/scan.schema.json",
  "title": "Recognizer scan document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanner",
    "commit",
    "modules",
    "edges",
    "foreign"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "commit": { "type": ["string", "null"], "minLength": 1 },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "foreign": { "type": "array", "items": { "$ref": "#/$defs/foreignNode" } },
    "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^(?!foreign:)(?!\\./)(?!/)[^\\\\]+$"
    },
    "foreignId": { "type": "string", "pattern": "^foreign:.+$" },
    "line": { "type": "integer", "minimum": 1 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "kind", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "language": { "enum": ["python", "typescript", "kotlin"] },
        "kind": { "enum": ["module", "package", "interface"] },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "line", "exported"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["class", "function", "interface", "type", "constant"]
        },
        "line": { "$ref": "#/$defs/line" },
        "exported": { "type": "boolean" },
        "bases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
        "params": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "returns": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/tags" },
        "value": { "type": "string", "maxLength": 40 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["class", "interface"] } }
          },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                { "required": ["bases"] },
                { "required": ["fields"] },
                { "required": ["methods"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "function" } } },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                { "required": ["params"] },
                { "required": ["returns"] },
                { "required": ["tags"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "constant" } } },
          "then": {},
          "else": { "not": { "anyOf": [{ "required": ["value"] }] } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind", "line"],
      "properties": {
        "from": { "$ref": "#/$defs/moduleId" },
        "to": {
          "oneOf": [
            { "$ref": "#/$defs/moduleId" },
            { "$ref": "#/$defs/foreignId" }
          ]
        },
        "kind": { "enum": ["depends", "inherits", "implements"] },
        "line": { "$ref": "#/$defs/line" },
        "member": { "type": "string", "minLength": 1 },
        "to_member": { "type": "string", "minLength": 1 },
        "names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "via": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/moduleId" },
          "uniqueItems": true
        },
        "inferred": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter", "methods", "class", "implementations"],
          "properties": {
            "parameter": { "type": "string", "minLength": 1 },
            "methods": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "class": { "type": "string", "minLength": 1 },
            "implementations": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      },
      "unevaluatedProperties": false,
      "if": {
        "properties": { "kind": { "enum": ["inherits", "implements"] } }
      },
      "then": {
        "required": ["member", "to_member"],
        "not": {
          "anyOf": [
            { "required": ["names"] },
            { "required": ["via"] },
            { "required": ["inferred"] }
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [{ "required": ["member"] }, { "required": ["to_member"] }]
        }
      }
    },
    "foreignNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/foreignId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "line", "params", "private"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "line": { "$ref": "#/$defs/line" },
        "params": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "returns": { "type": "string", "minLength": 1 },
        "private": { "type": "boolean" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["property", "static", "classmethod", "abstract", "async"]
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "line", "how"],
      "properties": {
        "from": { "$ref": "#/$defs/memberRef" },
        "to": { "$ref": "#/$defs/memberRef" },
        "line": { "$ref": "#/$defs/line" },
        "how": { "enum": ["call", "construct", "inferred", "dispatch"] }
      }
    },
    "memberRef": {
      "type": "string",
      "pattern": "^(?!foreign:)(?!\\./)(?!/)[^\\\\]+::[^:]+$"
    }
  }
}
