{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/findings.schema.json",
  "title": "Recognizer findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings_version", "sensor", "commit", "modified", "settings", "findings"],
  "properties": {
    "findings_version": { "enum": [1, 2] },
    "inputs": { "$ref": "#/$defs/hashes" },
    "diagnosis": { "$ref": "#/$defs/diagnosis" },
    "tests": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "performed", "reused"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "performed": { "type": "integer", "minimum": 0 },
        "reused": { "type": "integer", "minimum": 0 }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "ran_at"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "failed", "partial", "never"] },
          "ran_at": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" }
            ]
          },
          "reason": { "type": "string", "minLength": 1 },
          "measured": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "ran": { "type": "boolean" }
        },
        "if": { "properties": { "status": { "const": "never" } }, "required": ["status"] },
        "then": { "properties": { "ran_at": { "type": "null" } } },
        "else": { "properties": { "ran_at": { "type": "string" } } }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "commit": { "type": "string", "minLength": 1 },
    "modified": { "type": "boolean" },
    "settings": { "type": "object" },
    "reported_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "stopped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "total"],
      "properties": {
        "measured": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "partial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "total"],
      "properties": {
        "measured": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "total"],
      "properties": {
        "measured": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functions", "modules"],
      "properties": {
        "functions": { "type": "integer", "minimum": 0 },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unowned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functions", "modules"],
      "properties": {
        "functions": { "type": "integer", "minimum": 0 },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "principle", "summary", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["violation", "warning"] },
          "principle": { "type": "string", "minLength": 1 },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["author", "work", "year"],
            "properties": {
              "author": { "type": "string", "minLength": 1 },
              "work": { "type": "string", "minLength": 1 },
              "year": { "type": "integer" },
              "locator": { "type": "string", "minLength": 1 }
            }
          },
          "summary": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "fix_pattern": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modules"],
            "properties": {
              "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "test_importers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["file", "names"],
                  "properties": {
                    "file": { "type": "string", "minLength": 1 },
                    "names": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "to": { "type": "string", "minLength": 1 },
                    "kind": { "type": "string", "minLength": 1 },
                    "lines": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
                    "rules": { "type": "array", "items": { "type": "object" } }
                  }
                }
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["module", "name"],
                  "properties": {
                    "module": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 },
                    "file": { "type": "string", "minLength": 1 },
                    "lines": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": { "type": "integer", "minimum": 1 }
                    },
                    "test_files": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              "measures": { "type": "object", "additionalProperties": { "type": "number" } },
              "producer": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "line"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "unmeasured": {
          "type": "boolean"
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "failing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "names"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "names": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "findings_version": { "const": 2 } } },
      "then": { "required": ["inputs"] }
    }
  ]
}
