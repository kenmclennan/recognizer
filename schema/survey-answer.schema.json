{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/survey-answer.schema.json",
  "title": "Recognizer setup survey answer",
  "description": "What a scanner prints for `<command> survey REQUEST_FILE`: the test runners, tools and notes for its own languages. A tool's needed_by lists the from values of its runners; {up} and {slug} are placeholders core fills in once runner names are known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runners",
    "tools",
    "notes"
  ],
  "properties": {
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "runner",
          "directory",
          "from",
          "command",
          "coverage",
          "tool"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "lcov",
                  "jacoco"
                ]
              }
            }
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "activate": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "installed",
          "why",
          "needed_by",
          "installs",
          "command",
          "cwd"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "npm",
              "cargo",
              "pip"
            ]
          },
          "installed": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          },
          "needed_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "installs": {
            "type": "string"
          },
          "prepare": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "undo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "undo_note": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "directory",
          "text"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
