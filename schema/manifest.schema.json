{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/manifest.schema.json",
  "title": "Recognizer plugin manifest",
  "description": "What a plugin prints for `<command> manifest`: one JSON document and a newline on stdout. Whether protocol is in range is judged by the CLI, never by this schema. A settings entry is the shape of one entry of keys in config-keys.schema.json, with the key relative to the plugin's own section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "display",
    "version",
    "protocol",
    "install",
    "check",
    "long_running",
    "units",
    "settings"
  ],
  "properties": {
    "kind": {
      "enum": [
        "scanner",
        "sensor",
        "describer"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "display": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "boolean"
    },
    "long_running": {
      "type": "boolean"
    },
    "time_limit_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "scan_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "assistant": {
      "$ref": "#/$defs/assistant"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "runs_tests": {
      "type": "boolean"
    },
    "reports_tests": {
      "type": "boolean"
    },
    "setup_survey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scoped": {
      "type": "boolean"
    },
    "planned_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb"
      ],
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "log_path": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "prices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "expansion": {
      "type": "string",
      "minLength": 1
    },
    "settings_title": {
      "type": "string",
      "minLength": 1
    },
    "placeholders": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "pattern"
            ]
          },
          {
            "required": [
              "values"
            ]
          }
        ]
      }
    },
    "suite_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "keys"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/suiteSection"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    }
  },
  "$defs": {
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "program",
        "account_note",
        "signed_out_reason",
        "signed_out_markers",
        "limit_markers"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "account_note": { "type": "string", "minLength": 1 },
        "signed_out_reason": { "type": "string", "minLength": 1 },
        "signed_out_markers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limit_markers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "work",
        "year"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "description",
        "example"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "path"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "multi": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "defaults": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "default_text": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "off": {
          "type": "boolean"
        },
        "retired": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "repository",
            "machine"
          ]
        },
        "switch": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "const": true
            },
            "unset": {
              "const": true
            }
          }
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "direction"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": [
                "above",
                "below"
              ]
            },
            "severity": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "enum"
          }
        }
      },
      "then": {
        "required": [
          "values"
        ]
      },
      "else": {
        "not": {
          "required": [
            "values"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "default",
              "defaults"
            ]
          },
          {
            "required": [
              "default",
              "default_text"
            ]
          },
          {
            "required": [
              "defaults",
              "default_text"
            ]
          },
          {
            "required": [
              "label",
              "labels"
            ]
          },
          {
            "required": [
              "unit",
              "units"
            ]
          },
          {
            "required": [
              "switch"
            ],
            "properties": {
              "switch": {
                "type": "object",
                "required": [
                  "value"
                ]
              },
              "off": {
                "not": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has"
          ],
          "properties": {
            "has": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "is"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "is": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "op",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/path"
            },
            "op": {
              "enum": [
                "gt",
                "lt",
                "eq"
              ]
            },
            "right": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "text": {
          "type": "string",
          "pattern": "^(?:[^{}]|\\{[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*(?:\\|(?:short|num|whole|percent|plural:[^:{}|]*:[^:{}|]*))?\\})*$"
        }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "parts"
      ],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/variant"
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "group",
        "help",
        "sentence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.([a-z0-9_-]+|<[a-z][a-z0-9_]*>))*$"
        },
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "means",
            "todo"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "means": {
              "type": "string",
              "minLength": 1
            },
            "todo": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "sentence": {
          "$ref": "#/$defs/sentence"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "help",
        "type",
        "granularity",
        "bad"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "ratio",
            "count",
            "number",
            "boolean"
          ]
        },
        "granularity": {
          "enum": [
            "module",
            "member"
          ]
        },
        "bad": {
          "enum": [
            "high",
            "low"
          ]
        },
        "cell": {
          "type": "integer",
          "minimum": 1
        },
        "unlisted": {
          "type": "boolean"
        },
        "published": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "extensions",
        "files",
        "skip"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "grammars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grammarRule"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[^/]+$"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory_names",
            "directory_prefixes",
            "directory_suffixes",
            "directory_markers",
            "file_globs"
          ],
          "properties": {
            "directory_names": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directory_prefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directory_suffixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directory_markers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "file_globs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "test_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testFileRule"
          }
        },
        "supertype_links": {
          "type": "boolean"
        },
        "private_imports": {
          "type": "boolean"
        }
      }
    },
    "grammarRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "extensions",
        "function_types",
        "scope_types",
        "branch_types",
        "boolean_operators",
        "bound_function_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[^/]+$"
          }
        },
        "function_types": {
          "$ref": "#/$defs/nodeList"
        },
        "scope_types": {
          "$ref": "#/$defs/nodeList"
        },
        "branch_types": {
          "$ref": "#/$defs/nodeList"
        },
        "boolean_operators": {
          "$ref": "#/$defs/nodeList"
        },
        "bound_function_types": {
          "$ref": "#/$defs/nodeList"
        },
        "function_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/functionNameRule"
          }
        },
        "span": {
          "$ref": "#/$defs/spanRule"
        },
        "vocabulary": {
          "$ref": "#/$defs/grammarVocabulary"
        }
      }
    },
    "grammarVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comment_markers": {
          "$ref": "#/$defs/nodeList"
        },
        "literal_types": {
          "$ref": "#/$defs/nodeList"
        },
        "literal_suffixes": {
          "$ref": "#/$defs/nodeList"
        },
        "call_types": {
          "$ref": "#/$defs/nodeList"
        },
        "identifier_types": {
          "$ref": "#/$defs/nodeList"
        },
        "identifier_suffixes": {
          "$ref": "#/$defs/nodeList"
        },
        "block_types": {
          "$ref": "#/$defs/nodeList"
        },
        "return_types": {
          "$ref": "#/$defs/nodeList"
        },
        "jump_types": {
          "$ref": "#/$defs/nodeList"
        },
        "return_keywords": {
          "$ref": "#/$defs/nodeList"
        },
        "assignment_types": {
          "$ref": "#/$defs/nodeList"
        },
        "positional_assignment_types": {
          "$ref": "#/$defs/nodeList"
        },
        "member_types": {
          "$ref": "#/$defs/nodeList"
        },
        "subscript_types": {
          "$ref": "#/$defs/nodeList"
        },
        "identifier_leaf_types": {
          "$ref": "#/$defs/nodeList"
        },
        "self_types": {
          "$ref": "#/$defs/nodeList"
        },
        "self_texts": {
          "$ref": "#/$defs/nodeList"
        },
        "shorthand_initialiser_types": {
          "$ref": "#/$defs/nodeList"
        },
        "field_initialiser_types": {
          "$ref": "#/$defs/nodeList"
        },
        "struct_literal_types": {
          "$ref": "#/$defs/nodeList"
        },
        "plain_name_types": {
          "$ref": "#/$defs/nodeList"
        },
        "expression_statement_types": {
          "$ref": "#/$defs/nodeList"
        },
        "docstring_string_types": {
          "$ref": "#/$defs/nodeList"
        },
        "argument_wrapper_types": {
          "$ref": "#/$defs/nodeList"
        },
        "argument_list_types": {
          "$ref": "#/$defs/nodeList"
        },
        "call_suffix_types": {
          "$ref": "#/$defs/nodeList"
        },
        "subscript_argument_list_types": {
          "$ref": "#/$defs/nodeList"
        },
        "parameter_list_types": {
          "$ref": "#/$defs/nodeList"
        },
        "expression_bodied_types": {
          "$ref": "#/$defs/nodeList"
        },
        "expression_body_types": {
          "$ref": "#/$defs/nodeList"
        },
        "function_body_types": {
          "$ref": "#/$defs/nodeList"
        },
        "name_leaf_types": {
          "$ref": "#/$defs/nodeList"
        },
        "binding_declarator_types": {
          "$ref": "#/$defs/nodeList"
        },
        "binding_name_types": {
          "$ref": "#/$defs/nodeList"
        },
        "operator_node_types": {
          "$ref": "#/$defs/nodeList"
        },
        "member_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberField"
          }
        },
        "node_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeNameRule"
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/fieldName"
            },
            "body": {
              "$ref": "#/$defs/fieldName"
            },
            "expression_body": {
              "$ref": "#/$defs/fieldName"
            },
            "parameters": {
              "$ref": "#/$defs/fieldName"
            },
            "parameter_pattern": {
              "$ref": "#/$defs/fieldName"
            },
            "arguments": {
              "$ref": "#/$defs/fieldName"
            },
            "callee": {
