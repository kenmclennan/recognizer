{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/config.schema.json",
  "title": "Recognizer repository config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "describer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "overlays": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "metrics"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "granularity",
                "bad"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "ratio",
                    "count",
                    "number",
                    "boolean"
                  ]
                },
                "granularity": {
                  "enum": [
                    "module",
                    "member"
                  ]
                },
                "bad": {
                  "enum": [
                    "high",
                    "low"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "sensors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "properties": {
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hub_threshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "warnings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cycle": {
                      "type": "boolean"
                    },
                    "hub": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            {
              "const": "off"
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
