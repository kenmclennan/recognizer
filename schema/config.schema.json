{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/config.schema.json",
  "title": "Recognizer repository config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "describer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sensors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "properties": {
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hub_threshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "instability_gap": {
                  "description": "The smallest instability gap between two folders for stable_dependencies to report.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "composition_roots": {
                  "description": "Folder-id globs exempt as the depending side of stable_dependencies.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "warnings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cycle": {
                      "type": "boolean"
                    },
                    "hub": {
                      "type": "boolean"
                    },
                    "policy_drift": {
                      "type": "boolean"
                    },
                    "stable_dependencies": {
                      "type": "boolean"
                    },
                    "unused_exports": {
                      "type": "boolean"
                    },
                    "orphan": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "entry_points"
                          ],
                          "properties": {
                            "entry_points": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "const": "off"
            }
          ]
        },
        "duplication": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "min_lines": {
                  "type": "integer",
                  "minimum": 1
                },
                "pair_min_lines": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_nodes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "crap": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "mutation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "carry": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "max_minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_workers": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "incremental": {
                  "type": "boolean"
                },
                "record": {
                  "type": "string",
                  "minLength": 1
                },
                "survivors": {
                  "type": "string",
                  "minLength": 1
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "thresholds": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": {
                  "const": "command"
                }
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "const": "off"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "above": {
                        "type": "number"
                      },
                      "below": {
                        "type": "number"
                      },
                      "severity": {
                        "enum": [
                          "warning",
                          "violation"
                        ]
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "above"
                        ],
                        "not": {
                          "required": [
                            "below"
                          ]
                        }
                      },
                      {
                        "required": [
                          "below"
                        ],
                        "not": {
                          "required": [
                            "above"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "directory",
          "command",
          "coverage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "python",
              "typescript",
              "kotlin",
              "rust",
              "csharp"
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^/"
                },
                {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              ]
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "activate": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^/"
                    },
                    {
                      "pattern": "(^|/)\\.\\.(/|$)"
                    }
                  ]
                }
              },
              "format": {
                "enum": [
                  "lcov",
                  "jacoco"
                ]
              }
            }
          },
          "runner": {
            "enum": [
              "vitest",
              "jest"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "language": {
                  "const": "typescript"
                }
              },
              "required": [
                "language"
              ]
            },
            "then": {
              "required": [
                "runner"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "runner"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
