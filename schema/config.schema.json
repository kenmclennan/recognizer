{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/config.schema.json",
  "title": "Recognizer repository config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "describer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scanners": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      }
    },
    "install": {
      "type": "object",
      "propertyNames": {
        "pattern": "^recognizer-(scan|sense|describe)-[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "properties": {
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "warnings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cycle": {
                      "type": "boolean"
                    },
                    "unused_exports": {
                      "type": "boolean"
                    },
                    "private_imports": {
                      "type": "boolean"
                    },
                    "long_function": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "limit"
                          ],
                          "properties": {
                            "limit": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      ]
                    },
                    "complexity": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "limit"
                          ],
                          "properties": {
                            "limit": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      ]
                    },
                    "orphan": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "entry_points": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "entry_annotations": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "duplication": {
                  "oneOf": [
                    {
                      "const": false
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "threshold": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        },
                        "min_lines": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "pair_min_lines": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "min_nodes": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "const": "off"
            }
          ]
        },
        "crap": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                },
                "coverage_limit": {
                  "oneOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    {
                      "const": false
                    }
                  ]
                }
              }
            }
          ]
        },
        "mutation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "carry": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "max_minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_workers": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "incremental": {
                  "type": "boolean"
                },
                "record": {
                  "type": "string",
                  "minLength": 1
                },
                "survivors": {
                  "type": "string",
                  "minLength": 1
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "directory",
          "command",
          "coverage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "python",
              "typescript",
              "kotlin",
              "rust",
              "csharp"
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^/"
                },
                {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              ]
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "activate": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^/"
                    },
                    {
                      "pattern": "(^|/)\\.\\.(/|$)"
                    }
                  ]
                }
              },
              "format": {
                "enum": [
                  "lcov",
                  "jacoco"
                ]
              }
            }
          },
          "runner": {
            "enum": [
              "vitest",
              "jest"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "language": {
                  "const": "typescript"
                }
              },
              "required": [
                "language"
              ]
            },
            "then": {
              "required": [
                "runner"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "runner"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
