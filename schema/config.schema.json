{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/config.schema.json",
  "title": "Recognizer repository config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "describer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sensors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "maxLength": 64
      },
      "properties": {
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hub_threshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "distance_threshold": {
                  "description": "Retired: accepted and ignored.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "warnings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cycle": {
                      "type": "boolean"
                    },
                    "hub": {
                      "type": "boolean"
                    },
                    "folder_cycle": {
                      "type": "boolean"
                    },
                    "policy_drift": {
                      "type": "boolean"
                    },
                    "stable_dependencies": {
                      "type": "boolean"
                    },
                    "stable_abstractions": {
                      "description": "Retired: accepted and ignored.",
                      "type": "boolean"
                    },
                    "unused_exports": {
                      "type": "boolean"
                    },
                    "orphan": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "entry_points"
                          ],
                          "properties": {
                            "entry_points": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "const": "off"
            }
          ]
        },
        "duplication": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "min_lines": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_nodes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "crap": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "test_command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "coverage": {
                  "type": "string",
                  "minLength": 1
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "mutation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "test_command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "max_minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_workers": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "incremental": {
                  "type": "boolean"
                },
                "record": {
                  "type": "string",
                  "minLength": 1
                },
                "survivors": {
                  "type": "string",
                  "minLength": 1
                },
                "coverage": {
                  "type": "string",
                  "minLength": 1
                },
                "overlay": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "thresholds": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": {
                  "const": "command"
                }
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "const": "off"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "above": {
                        "type": "number"
                      },
                      "below": {
                        "type": "number"
                      },
                      "severity": {
                        "enum": [
                          "warning",
                          "violation"
                        ]
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "above"
                        ],
                        "not": {
                          "required": [
                            "below"
                          ]
                        }
                      },
                      {
                        "required": [
                          "below"
                        ],
                        "not": {
                          "required": [
                            "above"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
