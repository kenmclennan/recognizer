{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/view.schema.json",
  "title": "Recognizer saved view",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "commit", "steps"],
  "properties": {
    "schema_version": { "enum": [1, 2, 3, 4] },
    "ordered": { "type": "boolean" },
    "change": { "$ref": "#/$defs/change" },
    "plan": { "const": true },
    "proposed": {
      "type": "array",
      "description": "What a plan says will happen to a module. At most one per module; when a file holds several on one module, readers keep the last.",
      "items": { "$ref": "#/$defs/proposedChange" }
    },
    "title": { "type": "string", "pattern": "\\S" },
    "description": { "type": "string", "pattern": "\\S" },
    "commit": { "type": ["string", "null"], "minLength": 1 },
    "note": { "$ref": "#/$defs/note" },
    "module_notes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/path" },
      "additionalProperties": { "$ref": "#/$defs/note" }
    },
    "notes": {
      "type": "array",
      "description": "At most one note per module; a module is a module path or a folder path with one trailing slash. When a file holds several notes on one path, readers keep the last.",
      "items": { "$ref": "#/$defs/viewNote" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "contains": {
        "type": "object",
        "properties": { "kind": { "const": "focus" } }, "required": ["kind"] },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["note"] }, { "required": ["module_notes"] }]
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "enum": [1, 2] } },
        "required": ["schema_version"]
      },
      "then": { "not": { "required": ["notes"] } }
    },
    {
      "if": {
        "properties": { "schema_version": { "enum": [3, 4] } },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["note"] }, { "required": ["module_notes"] }]
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "enum": [1, 2, 3] } },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["ordered"] },
            { "required": ["change"] },
            { "required": ["plan"] },
            { "required": ["proposed"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["proposed"] },
      "then": { "required": ["plan"] }
    },
    {
      "if": { "required": ["plan"] },
      "then": { "not": { "required": ["change"] } }
    }
  ],
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "base": { "$ref": "#/$defs/ref" },
        "head": { "$ref": "#/$defs/ref" },
        "name": { "type": "string", "pattern": "\\S" }
      }
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "kind"],
      "properties": {
        "module": { "$ref": "#/$defs/path" },
        "member": {
          "type": "string",
          "description": "A function, class or method in the module: Name, or Class.method. With member, kind is new, changes or removed and from is not allowed.",
          "pattern": "^[^#]+$"
        },
        "kind": {
          "enum": ["new", "changes", "moves", "moves-and-changes", "removed"]
        },
        "from": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        {
          "if": { "required": ["member"] },
          "then": {
            "properties": { "kind": { "enum": ["new", "changes", "removed"] } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["moves", "moves-and-changes"] } },
            "required": ["kind"]
          },
          "then": { "required": ["from"] },
          "else": { "not": { "required": ["from"] } }
        }
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./@+-]*$"
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "by"],
      "properties": {
        "text": { "type": "string", "pattern": "\\S" },
        "by": { "type": "string", "pattern": "\\S", "maxLength": 64 }
      }
    },
    "viewNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "text", "by"],
      "properties": {
        "module": { "$ref": "#/$defs/notePath" },
        "text": { "type": "string", "pattern": "\\S" },
        "by": { "type": "string", "pattern": "\\S", "maxLength": 64 }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\./)(?!/)[^\\\\]*[^\\\\/]$"
    },
    "notePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\./)(?!/)[^\\\\]*[^\\\\/]/?$"
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module"],
          "properties": {
            "kind": { "const": "pick" },
            "module": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "of"],
          "properties": {
            "kind": { "const": "rule" },
            "relation": { "const": "folder" },
            "of": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "of"],
          "properties": {
            "kind": { "const": "rule" },
            "relation": { "enum": ["uses", "used-by"] },
            "of": { "$ref": "#/$defs/path" },
            "within": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "folder"],
          "properties": {
            "kind": { "const": "fold" },
            "folder": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "folder"],
          "properties": {
            "kind": { "const": "focus" },
            "folder": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module"],
          "properties": {
            "kind": { "const": "left-out" },
            "module": { "$ref": "#/$defs/path" }
          }
        }
      ]
    }
  }
}
