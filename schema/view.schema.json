{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recognizer.dev/schema/view.schema.json",
  "title": "Recognizer saved view",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "commit", "steps"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "description": { "type": "string", "pattern": "\\S" },
    "commit": { "type": ["string", "null"], "minLength": 1 },
    "note": { "$ref": "#/$defs/note" },
    "module_notes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/path" },
      "additionalProperties": { "$ref": "#/$defs/note" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "contains": {
        "type": "object",
        "properties": { "kind": { "const": "focus" } }, "required": ["kind"] },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["note"] }, { "required": ["module_notes"] }]
        }
      }
    }
  ],
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "by"],
      "properties": {
        "text": { "type": "string", "pattern": "\\S" },
        "by": { "type": "string", "pattern": "\\S", "maxLength": 64 }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\./)(?!/)[^\\\\]*[^\\\\/]$"
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module"],
          "properties": {
            "kind": { "const": "pick" },
            "module": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "of"],
          "properties": {
            "kind": { "const": "rule" },
            "relation": { "const": "folder" },
            "of": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "of"],
          "properties": {
            "kind": { "const": "rule" },
            "relation": { "enum": ["uses", "used-by"] },
            "of": { "$ref": "#/$defs/path" },
            "within": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "folder"],
          "properties": {
            "kind": { "const": "fold" },
            "folder": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "folder"],
          "properties": {
            "kind": { "const": "focus" },
            "folder": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module"],
          "properties": {
            "kind": { "const": "left-out" },
            "module": { "$ref": "#/$defs/path" }
          }
        }
      ]
    }
  }
}
