{
  "kind": "sensor",
  "name": "thresholds",
  "display": "Thresholds",
  "description": "Turns any overlay metric over a configured line into a finding, with a coverage line built in.",
  "version": "0.1.0",
  "protocol": 1,
  "install": "brew upgrade kenmclennan/tap/recognizer-sense-thresholds || brew install kenmclennan/tap/recognizer-sense-thresholds",
  "check": false,
  "long_running": false,
  "time_limit_seconds": 60,
  "units": [
    "modules"
  ],
  "settings": [
    {
      "key": "<metric>",
      "type": "enum",
      "description": "turns the default threshold of a metric off",
      "example": "sensors.thresholds.coverage off",
      "values": [
        "off"
      ]
    },
    {
      "key": "<metric>.above",
      "type": "number",
      "description": "a finding when the metric is above this value; a metric takes above or below, not both",
      "example": "sensors.thresholds.churn.above 20",
      "order": 1,
      "limit": {
        "metric": "<metric>",
        "direction": "above",
        "severity": "<metric>.severity"
      }
    },
    {
      "key": "<metric>.below",
      "type": "number",
      "description": "a finding when the metric is below this value; a metric takes above or below, not both",
      "example": "sensors.thresholds.coverage.below 0.7",
      "defaults": {
        "coverage": 0.6
      },
      "labels": {
        "coverage": "Coverage below"
      },
      "units": {
        "coverage": "0 to 1"
      },
      "order": 2,
      "limit": {
        "metric": "<metric>",
        "direction": "below",
        "severity": "<metric>.severity"
      }
    },
    {
      "key": "<metric>.severity",
      "type": "enum",
      "description": "how a finding of the metric is reported; default warning",
      "example": "sensors.thresholds.coverage.severity violation",
      "values": [
        "warning",
        "violation"
      ],
      "defaults": {
        "coverage": "warning"
      }
    }
  ],
  "settings_title": "Coverage",
  "metrics": [],
  "findings": [
    {
      "kind": "thresholds.<metric>",
      "group": {
        "name": "Over a limit",
        "means": "A measure passed a limit set in your config, such as module size. The published line is coverage below 60% (Google's guidelines).",
        "todo": "Bring it back under the limit, or raise the limit if it is wrong."
      },
      "help": "One finding per module or function whose metric passed a configured limit.",
      "sentence": {
        "requires": [
          "evidence.measures.value",
          "evidence.measures.line",
          "evidence.modules.0"
        ],
        "parts": [
          [
            {
              "when": [
                {
                  "has": "evidence.members.0.name"
                }
              ],
              "text": "{evidence.members.0.name} in {evidence.members.0.module|short}"
            },
            {
              "text": "{evidence.modules.0|short}"
            }
          ],
          [
            {
              "text": " has {metric} {evidence.measures.value|num}, "
            }
          ],
          [
            {
              "when": [
                {
                  "left": "evidence.measures.value",
                  "op": "gt",
                  "right": "evidence.measures.line"
                }
              ],
              "text": "over the limit of {evidence.measures.line|num}"
            },
            {
              "when": [
                {
                  "left": "evidence.measures.value",
                  "op": "lt",
                  "right": "evidence.measures.line"
                }
              ],
              "text": "under the limit of {evidence.measures.line|num}"
            },
            {
              "text": "at the limit of {evidence.measures.line|num}"
            }
          ],
          [
            {
              "text": "."
            }
          ]
        ]
      }
    }
  ],
  "runs_tests": false,
  "scoped": false
}
