{
  "kind": "describer",
  "name": "claude",
  "display": "Claude",
  "version": "0.1.0",
  "protocol": 4,
  "install": "brew install --cask kenmclennan/tap/recognizer",
  "check": true,
  "long_running": false,
  "time_limit_seconds": 120,
  "units": [
    "modules"
  ],
  "settings": [
    {
      "key": "model",
      "type": "string",
      "scope": "machine",
      "label": "Model",
      "default": "haiku",
      "description": "the model every description uses, for scans started from the app and from a terminal",
      "example": "describing.model haiku",
      "order": 1
    }
  ],
  "prices": {
    "haiku": {
      "input": 0.1,
      "output": 0.5
    },
    "sonnet": {
      "input": 2,
      "output": 10
    },
    "opus": {
      "input": 4,
      "output": 20
    }
  },
  "prompt_version": "prompt-b450a986f729",
  "assistant": {
    "name": "Claude",
    "program": "claude",
    "account_note": "Uses your Claude account.",
    "signed_out_reason": "Claude Code is not signed in. Open a terminal, run claude and sign in, then try again.",
    "signed_out_markers": [
      "not logged in"
    ],
    "limit_markers": [
      "usage limit",
      "rate limit"
    ],
    "extra": "x"
  }
}
