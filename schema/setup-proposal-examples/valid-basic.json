{
  "summary": "One doctor fix, one suite, a draft policy",
  "changes": [
    {
      "section": "problems",
      "title": "Drop the retired key",
      "reason": "doctor reports config-retired",
      "commands": [["recognizer", "config", "--unset", "sensors.duplication"]]
    },
    {
      "section": "tests",
      "title": "Confirm the suites by running them",
      "reason": "proves the registered commands work",
      "commands": [["recognizer", "sensors", "check", "--run"]]
    },
    {
      "section": "policy",
      "title": "Forbid the application layer importing adapters",
      "reason": "the modules fall into an application layer and an adapters layer",
      "commands": [
        [
          "recognizer",
          "policy",
          "--add-forbid",
          "--from",
          "src/application/**",
          "--to",
          "src/adapters/**"
        ]
      ]
    }
  ]
}
