[
  {
    "name": "python",
    "display": "Python",
    "grammars": [
      {
        "name": "python",
        "extensions": [
          ".py"
        ],
        "function_types": [
          "function_definition"
        ],
        "scope_types": [
          "class_definition"
        ],
        "branch_types": [
          "if_statement",
          "elif_clause",
          "for_statement",
          "while_statement",
          "except_clause",
          "conditional_expression",
          "for_in_clause",
          "if_clause",
          "case_clause"
        ],
        "boolean_operators": [
          "and",
          "or"
        ],
        "bound_function_types": []
      }
    ],
    "extensions": [
      ".py"
    ],
    "files": [],
    "skip": {
      "directory_names": [
        "__pycache__",
        "test",
        "tests",
        "dist",
        "build",
        "node_modules",
        "site-packages"
      ],
      "directory_prefixes": [
        "."
      ],
      "directory_suffixes": [
        ".egg-info"
      ],
      "directory_markers": [
        "pyvenv.cfg"
      ],
      "file_globs": [
        "conftest.py"
      ]
    }
  },
  {
    "name": "typescript",
    "display": "TypeScript",
    "grammars": [
      {
        "name": "typescript",
        "extensions": [
          ".ts",
          ".mts",
          ".cts"
        ],
        "function_types": [
          "function_declaration",
          "method_definition"
        ],
        "scope_types": [
          "class_declaration",
          "abstract_class_declaration",
          "class",
          "internal_module",
          "module"
        ],
        "branch_types": [
          "if_statement",
          "for_statement",
          "for_in_statement",
          "while_statement",
          "do_statement",
          "switch_case",
          "catch_clause",
          "ternary_expression",
          "optional_chain"
        ],
        "boolean_operators": [
          "&&",
          "||",
          "??"
        ],
        "bound_function_types": [
          "arrow_function",
          "function_expression",
          "function"
        ]
      },
      {
        "name": "tsx",
        "extensions": [
          ".tsx",
          ".jsx",
          ".js",
          ".mjs",
          ".cjs"
        ],
        "function_types": [
          "function_declaration",
          "method_definition"
        ],
        "scope_types": [
          "class_declaration",
          "abstract_class_declaration",
          "class",
          "internal_module",
          "module"
        ],
        "branch_types": [
          "if_statement",
          "for_statement",
          "for_in_statement",
          "while_statement",
          "do_statement",
          "switch_case",
          "catch_clause",
          "ternary_expression",
          "optional_chain"
        ],
        "boolean_operators": [
          "&&",
          "||",
          "??"
        ],
        "bound_function_types": [
          "arrow_function",
          "function_expression",
          "function"
        ]
      }
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".mts",
      ".cts"
    ],
    "files": [
      "tsconfig.json"
    ],
    "skip": {
      "directory_names": [
        "node_modules",
        "dist",
        "build",
        "test",
        "tests",
        "__tests__"
