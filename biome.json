{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "check/**",
      "scanners/typescript/**",
      "describers/**",
      "app/**",
      "scripts/**",
      "!**/dist",
      "!**/src/generated",
      "!**/node_modules",
      "!**/src-tauri/target"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["app/src/style.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
