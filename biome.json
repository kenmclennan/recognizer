{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "check/**",
      "scanners/typescript/**",
      "app/**",
      "scripts/**",
      "!**/dist",
      "!**/src/generated",
      "!**/node_modules",
      "!**/src-tauri/target"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true
  }
}
